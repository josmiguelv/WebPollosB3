# URL COMPLETA de un endpoint PUBLICO y de solo lectura del administrador
# que YA utiliza la app Android. No colocar claves administrativas aquí.
# VITE_B3_PUBLIC_CATALOG_URL=https://DOMINIO_REAL/ENDPOINT_PUBLICO_VERIFICADO

# URL HTTPS del EMBED WEB oficial de TU VERSO cuando el canal WEB exista,
# esté autorizado para este dominio y haya sido validado.
# VITE_TUVERSO_WEB_EMBED_URL=https://DOMINIO_REAL/EMBED_WEB_VALIDADO

# SOLO PARA UNA PREVIEW CERRADA; en producción debe estar ausente o false.
VITE_B3_ENABLE_DESIGN_PREVIEW=false

# URLs oficiales verificadas y autorizadas por Pollos B3.
# Si faltan, los enlaces NO se muestran públicamente.
# VITE_B3_INSTAGRAM_URL=https://www.instagram.com/CUENTA_OFICIAL
# VITE_B3_TIKTOK_URL=https://www.tiktok.com/@CUENTA_OFICIAL
# VITE_B3_FACEBOOK_URL=https://www.facebook.com/PAGINA_OFICIAL

# Piloto de Carta: habilitado por defecto. false para restablecer todas las rutas.
VITE_B3_CARTA_PILOT=true

# Configuración pública móvil proporcionada para Pollos B3 (appId fijo).
# Por defecto se usa el URL trycloudflare compartido por el cliente.
# El túnel trycloudflare es temporal: reemplazar por dominio permanente con HTTPS.
# VITE_B3_MOBILE_CONFIG_URL=https://surprise-kong-stories-brand.trycloudflare.com/api/v1/mobile/config?appId=com.integrab2g.pollosb3

# En npm run dev se usa un proxy de Vite para evitar CORS:
# /b3-mobile-config y /b3-mobile-images.
# En producción se necesita CORS habilitado para el dominio web, o proxy HTTPS de mismo origen.

# La web de Carta tiene autorizado el túnel de prueba actualmente activo.
# Si Cloudflare genera otro enlace, antes de iniciar npm run dev en PowerShell:
# $env:__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS="nuevo-enlace.trycloudflare.com"
# Nunca utilizar server.allowedHosts: true en un servidor Vite público.

# Fase de reutilización Android -> Web. Desactivada en la Carta pública.
# Activar solo tras certificar contrato, CORS/proxy y agentes de prueba.
VITE_B3_WEB_ORDER_ENABLED=false
